{
  "name": "vectorprep",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "npm run assets && vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run assets && npm run typecheck && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "comlink": "4.4.2",
    "jszip": "3.10.2",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
